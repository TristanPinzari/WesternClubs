# WHAT: A template listing every setting the server needs. Your real values go in
#   server/.env (never committed). This file is committed so everyone knows what to fill in.
# WITHOUT IT: New teammates wouldn't know which settings to create, and the server would
#   refuse to start.

# Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://user:password@host.neon.tech/orbit?sslmode=verify-full

PORT=3000

# Public URL of the frontend. Locally this is the Vite dev server;
# in production it's the Vercel URL, since Vercel proxies /api to this server.
APP_URL=http://localhost:5173

# Generate with: npx auth secret   (must be 32+ characters)
BETTER_AUTH_SECRET=change-me

# Shared team bucket. Ask Tristan for the orbit-server access key.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=orbit-media-1
